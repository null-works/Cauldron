{% set layoutConfig = {
    '2x2': { cols: 'grid-cols-2', count: 4 },
    '1x4': { cols: 'grid-cols-4', count: 4 },
    '3x2': { cols: 'grid-cols-3', count: 6 },
    '2x3': { cols: 'grid-cols-2', count: 6 }
} %}

{% set selectedLayout = layoutConfig[data.layout|default('2x2')] %}
{% set postCount = data.post_count|default(selectedLayout.count) %}

<section class="blog-posts-section py-8 {{ data.custom_css_class }}">
    {% if data.title %}
        <div class="text-center mb-8">
            <h2 class="text-3xl font-bold text-panic-purple glow">{{ data.title }}</h2>
            {% if data.subtitle %}
                <p class="text-panic-text/80 mt-2">{{ data.subtitle }}</p>
            {% endif %}
        </div>
    {% endif %}
    
    {% set posts = Winter.Blog.Models.Post.published().take(postCount).get() %}
    <!-- Debug: Found {{ posts.count() }} published posts -->
    <div class="blog-grid grid {{ selectedLayout.cols }} gap-6 max-w-6xl mx-auto">
        {% for post in posts %}
            <article class="blog-card bg-panic-dark border-2 border-panic-purple/50 rounded-lg overflow-hidden hover:border-panic-cyan transition-all duration-300 group" style="box-shadow: 0 4px 15px var(--panic-glow);">
                <a href="/blog/post/{{ post.slug }}" class="block">
                    {% if post.featured_images|length %}
                        <div class="aspect-video overflow-hidden">
                            <img src="{{ post.featured_images[0].getPath() | resize(600, 400) }}" 
                                 alt="{{ post.title }}" 
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                        </div>
                    {% else %}
                        <div class="aspect-video bg-gradient-to-br from-panic-deep to-panic-purple flex items-center justify-center">
                            <div class="text-panic-text opacity-50 text-4xl">
                                <i class="icon-file-text-o"></i>
                            </div>
                        </div>
                    {% endif %}
                    
                    <div class="p-6">
                        <h3 class="text-xl font-bold text-panic-text mb-2 group-hover:text-panic-cyan transition-colors">
                            {{ post.title }}
                        </h3>
                        
                        {% if data.show_excerpt and post.summary %}
                            <p class="text-panic-text/80 text-sm mb-4 line-clamp-3">
                                {{ post.summary }}
                            </p>
                        {% endif %}
                        
                        <div class="flex items-center justify-between text-xs text-panic-text/60">
                            <div class="flex items-center space-x-4">
                                {% if data.show_date %}
                                    <time datetime="{{ post.published_at|date('c') }}">
                                        {{ post.published_at|date('M j, Y') }}
                                    </time>
                                {% endif %}
                                {% if data.show_author and post.user %}
                                    <span>by {{ post.user.name }}</span>
                                {% endif %}
                            </div>
                            <span class="bg-panic-purple/20 px-2 py-1 rounded text-panic-cyan">
                                Read More →
                            </span>
                        </div>
                    </div>
                </a>
            </article>
        {% else %}
            <!-- Keep placeholders if no posts exist yet -->
            {% for i in 1..postCount %}
                <article class="blog-card bg-panic-dark border-2 border-panic-purple/50 rounded-lg overflow-hidden hover:border-panic-cyan transition-all duration-300 group" style="box-shadow: 0 4px 15px var(--panic-glow);">
                    <div class="aspect-video bg-gradient-to-br from-panic-deep to-panic-purple flex items-center justify-center">
                        <div class="text-panic-text opacity-50 text-4xl">
                            <i class="icon-file-text-o"></i>
                        </div>
                    </div>
                    
                    <div class="p-6">
                        <h3 class="text-xl font-bold text-panic-text mb-2 group-hover:text-panic-cyan transition-colors">
                            Create Blog Post {{ i }}
                        </h3>
                        
                        <p class="text-panic-text/80 text-sm mb-4 line-clamp-3">
                            Go to Blog → Posts in your admin panel to create your first blog post. It will automatically appear here.
                        </p>
                        
                        <div class="flex items-center justify-between text-xs text-panic-text/60">
                            <time>Waiting for content...</time>
                            <span class="bg-panic-purple/20 px-2 py-1 rounded text-panic-cyan">
                                Create Post →
                            </span>
                        </div>
                    </div>
                </article>
            {% endfor %}
        {% endfor %}
    </div>
</section>
